# deploy-host: shelly
# Read by deploy/check-unit-drift.sh, which diffs this file against
# /etc/systemd/system/ on that host every deploy. `local` is the VPS.
# Weekly refresh of OSRM-foot Finland data set.
[Unit]
Description=Refresh OSRM-foot Finland data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/osrm-refresh
