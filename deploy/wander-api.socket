# deploy-host: local
# Read by deploy/check-unit-drift.sh, which diffs this file against
# /etc/systemd/system/ on that host every deploy. `local` is the VPS.
#
# wander-api's only listener. nginx is the one intended client, and 0660
# root:www-data makes it the only one that can connect: every other local uid
# could reach the old 127.0.0.1:3700, and wander-api trusted X-Real-IP from any
# loopback peer, so any of them could pick a fresh rate-limit key per request
# (finding #10094). The service trusts forwarding headers only on this socket.
#
# Ownership and mode are declared here, by PID 1, rather than chmod'd by the
# service — whose CapabilityBoundingSet is empty, so it could not chgrp to
# www-data anyway. Same shape as bench.socket.

[Unit]
Description=Wander API (cloud backup) socket

[Socket]
ListenStream=/run/wander-api.sock
SocketMode=0660
SocketUser=root
SocketGroup=www-data

[Install]
WantedBy=sockets.target
